generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Health {
  GREEN
  ORANGE
  RED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionType {
  ACTION
  TASK
  BUG
  INCIDENT
  EVOLUTION
  JALON
}

enum ActionStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

model Project {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  projectEnabled     Boolean @default(true)
  maintenanceEnabled Boolean @default(false)

  phase    String?
  progress Int?
  health   Health  @default(GREEN)
  color    String  @default("sky")

  actions    Action[]
  risks      Risk[]
  timesheets TimesheetEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Action {
  id        String     @id @default(cuid())
  reference String     @unique
  type      ActionType @default(ACTION)

  title       String
  description String?

  startDate DateTime?
  dueDate   DateTime?

  estimatedHours Decimal? @db.Decimal(6, 2)

  owner    String?
  status   ActionStatus @default(TODO)
  priority Priority     @default(MEDIUM)

  source String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  timesheets TimesheetEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([dueDate])
  @@index([type])
  @@index([status])
}

model Risk {
  id        String @id @default(cuid())
  reference String @unique

  title       String
  probability Int
  impact      Int
  level       String

  owner      String?
  mitigation String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model TimesheetEntry {
  id       String   @id @default(cuid())
  date     DateTime
  hours    Decimal  @db.Decimal(5, 2)
  activity String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  actionId String?
  action   Action? @relation(fields: [actionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, date])
  @@index([actionId])
}
